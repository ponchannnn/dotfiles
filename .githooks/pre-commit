#!/usr/bin/env bash
# Scan staged changes for secrets before allowing a commit.
set -euo pipefail
cd "$HOME"

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not installed, skipping secret scan (brew install gitleaks / apt install gitleaks)" >&2
    exit 0
fi

gitleaks protect --staged --source "$HOME"
