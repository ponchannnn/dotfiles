# Bare-repo dotfiles: ignore everything by default,
# then explicitly allow-list what's tracked.
/*

# --- top-level dotfiles ---
!/.gitignore
!/.zshrc
!/.gitconfig
!/.vimrc

# --- bootstrap tooling (lives at repo root == $HOME) ---
!/bootstrap.sh
!/export-packages.sh
!/README.md
!/packages/

# --- .config: allow-list specific tools only ---
!/.config
/.config/*
!/.config/nvim
!/.config/wezterm

# --- dotfiles-research: local planning notes, only push what's finalized ---
!/dotfiles-research
/dotfiles-research/*
!/dotfiles-research/unused-apps.md
!/dotfiles-research/essential-cli-configs.md
!/dotfiles-research/decisions.md
