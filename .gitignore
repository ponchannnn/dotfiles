# Bare-repo dotfiles: ignore everything by default,
# then explicitly allow-list what's tracked.
/*

# --- top-level dotfiles ---
!/.gitignore
!/.zshrc
!/.gitconfig
!/.vimrc
!/CLAUDE.md
!/.githooks/

# --- bootstrap tooling (lives at repo root == $HOME) ---
!/bootstrap.sh
!/export-packages.sh
!/README.md
!/packages/

# --- .config: allow-list specific tools only ---
!/.config
/.config/*
!/.config/nvim
!/.config/wezterm
!/.config/tmux

# --- .claude: only the config bits, never sessions/history/cache/secrets ---
!/.claude
/.claude/*
!/.claude/settings.json
!/.claude/CLAUDE.md
!/.claude/statusline-command.sh
!/.claude/themes
/.claude/themes/*
!/.claude/themes/nerv.json

# dotfiles-research/ is local planning notes only, never pushed (see README)
