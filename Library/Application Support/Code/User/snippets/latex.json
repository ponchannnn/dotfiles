{
    "画像１枚表示":{
        "prefix":"img1",
        "body":["%画像を１枚(jpg/png)表示",
        "\\begin{figure}[h]",
        "  \\begin{${1:center}}",
        "    \\includegraphics[width=${2:8}cm]{${3:source}}",
        "    \\caption{${4:caption}}\\label{${5:label}}",
        "  \\end{${1:center}}",
        "\\end{figure}",
        "\n",
        "$6"
        ],
        "description": "１枚画像を表示する"
    },
    "画像２枚表示":{
