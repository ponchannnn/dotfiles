        "      \\begin{minipage}{0.5\\hsize}",
        "        \\begin{${1:center}}",
        "          \\includegraphics[width=${2:7}cm]{${3:source}}",
        "        \\end{${1:center}}",
        "        \\caption{${5:caption}}\\label{${6:label}}",
        "      \\end{minipage}",
        "",
        "      \\begin{minipage}{0.5\\hsize}",
        "        \\begin{${1:center}}",
        "          \\includegraphics[width=${2:7}cm]{${7:source}}",
        "        \\end{${1:center}}",
        "        \\caption{${8:caption}}\\label{${9:label}}",
        "      \\end{minipage}",
        "",
        "    \\end{tabular}",
        "  \\end{${1:center}}",
        "\\end{figure}",
        "\n",
        "$10"
        ]
    },
