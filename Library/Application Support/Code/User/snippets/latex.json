    "レポートテンプレ":{
        "prefix": "report",
        "body": [
        "\\documentclass[a4paper,11pt]{ltjsarticle} %A4: 21.0 x 29.7cm",
        "\\usepackage{amsmath,amsfonts,amssymb}",
        "\\usepackage{mathtools}",
        "\\usepackage{bm}",
        "\\usepackage{ascmac}",
        "\\usepackage{fancybox}",
        "\\usepackage{graphics}",
        "\\usepackage{graphicx,xcolor}",
        "\\usepackage{here} %画像の表示位置調整用",
        "\\usepackage{type1cm}",
        "\\usepackage[hidelinks]{hyperref}",
        "\\usepackage{enumerate}",
        "\\usepackage{listings,jvlisting}",
        "",
        "% 句読点（、。）を含む文字のカテゴリーコードをアクティブ化",
        "\\ltjsetparameter{kcatcode={0x3001,15}} % 、",
        "\\ltjsetparameter{kcatcode={0x3002,15}} % 。",
        "\\usepackage{newunicodechar}",
        "\\newunicodechar{、}{，}",
        "\\newunicodechar{。}{．}",
        "",
        "% メタデータの設定",
        "\\hypersetup{",
        "pdftitle={},",
        "pdfauthor={池田 瑞基},",
        "pdfsubject={}",
        "}",
        "\\begin{document}",
        "\\title{",
        "${5}",
        "%\\large{\\\\\\副題がある場合はここに記入}",
        "}",
        "\\author{${6}}",
        "\\date{${7:\\today}}",
        "\\maketitle",
        "\\section{}",
        "\\subsection{}",
        "",
        "",
        "$0",
        "",
        "",
        "\\end{document}"
        ],
        "description": "レポート用テンプレート"
    },
    "ミニレポート": {
		"prefix": "minireport",
		"body": [
			"\\documentclass[a4paper,11pt]{ltjsarticle} %A4: 21.0 x 29.7cm",
            "\\usepackage{amsmath,amsfonts,amssymb}",
            "\\usepackage{mathtools}",
            "\\usepackage{bm}",
            "\\usepackage{ascmac}",
            "\\usepackage{fancybox}",
            "\\usepackage{graphics}",
            "\\usepackage{graphicx,xcolor}",
            "\\usepackage{here} %画像の表示位置調整用",
            "\\usepackage{type1cm}",
            "\\usepackage[hidelinks]{hyperref}",
            "\\usepackage{enumerate}",
            "\\usepackage{listings,jvlisting}",
			"\\usepackage{titling} % タイトルをカスタマイズするためのパッケージ",
			"",
			"\\preauthor{\\begin{flushright}} % authorを右寄せにする",
			"\\postauthor{\\end{flushright}}",
			"\\predate{\\begin{flushright}} % dateを右寄せにする",
			"\\postdate{\\end{flushright}}",
			"",
            "% 句読点（、。）を含む文字のカテゴリーコードをアクティブ化",
            "\\ltjsetparameter{kcatcode={0x3001,15}} % 、",
            "\\ltjsetparameter{kcatcode={0x3002,15}} % 。",
            "\\usepackage{newunicodechar}",
            "\\newunicodechar{、}{，}",
            "\\newunicodechar{。}{．}",
			"",
            "% メタデータの設定",
            "\\hypersetup{",
            "pdftitle={},",
            "pdfauthor={池田 瑞基},",
            "pdfsubject={}",
            "}",
			"",
			"\\title{\\vspace{-4cm}${0:タイトル}}",
			"\\author{${1:氏名}}",
			"\\date{${2:\\today}}",
			"",
			"",
			"\\begin{document}",
			"\\maketitle",
			"",
			"\\end{document}"
		],
		"description": "小規模なレポートを書くためのテンプレート"
	},
    "スライドテンプレ":{
        "prefix": "slide",
        "body": [
        "\\documentclass[unicode,11pt]{beamer}",
        "\\usepackage{luatexja}",
        "\\usepackage{amsmath,amsfonts,amssymb}",
        "\\usepackage{mathtools}",
        "\\usepackage{bm}",
        "\\usepackage{ascmac}",
        "\\usepackage{fancybox}",
        "\\usepackage{graphics}",
        "\\usepackage{graphicx,xcolor}",
        "\\usepackage{here}",
        "\\usepackage{type1cm}",
        "\\usepackage{hyperref}",
        "\\usepackage{enumerate}",
        "\\renewcommand{\\kanjifamilydefault}{\\gtdefault} %既定をゴシック体に",
        "\\usefonttheme{professionalfonts} %Beamerによる数式フォントの置き換えを阻止",
        "\\usetheme[numbering=fraction]{metropolis}",
        "\\definecolor{tractorred}{rgb}{0.99, 0.05, 0.21}",
        "\\definecolor{limegreen}{rgb}{0.2, 0.8, 0.2}",
        "%Theme colors are derived from these two elements",
        "%色変更はここ(https://latexcolor.com/)から行える",
        "\\setbeamercolor{alerted text}{fg=tractorred}",
        "\\setbeamercolor{frametitle}{bg=limegreen}",
        "",
        "\\title${1}",
        "\\subtitle{}",
        "\\date{\\today}",
        "\\author{}",
        "\\institute{}",
        "\\begin{document}",
        "\\maketitle",
        "\\section{}",
        "\\begin{frame}{}",
        "  ",
        "\\end{frame}",
        "\\end{document}"
        ],
        "description": "スライド用テンプレート"
    },
    "表挿入":{
        "prefix": "hyo",
        "body": [
        "\\begin{table}[H]",
        "  \\caption{}",
        "  \\centering",
        "  \\begin{tabular}{c|c|c}   %列数はここで変える",
        "    \\hline",
        "      &  &  \\\\\\\\",
        "    \\hline \\hline",
        "      &  &  \\\\\\\\",
        "      &  &  \\\\\\\\",
        "      &  &  \\\\\\\\",
        "    \\hline",
        "  \\end{tabular}",
        "\\end{table}"
        ],
        "description": "表挿入"
    },
