    "式":{
        "prefix": "siki",
        "body":[
        "\\begin{equation}",
        "  \\begin{split}",
        "    ${0}",
        "  \\end{split}",
        "\\end{equation}"
        ],
        "description": "式を表示するテンプレ"
    },
    "プログラム": {
        "prefix": "program",
        "body": [
            "% --- ここからソースコード表示用設定 ---",
            "\\usepackage[no-math,deluxe,expert,haranoaji]{luatexja-preset}",
            "\\usepackage{color}",
            "\\usepackage{listings,jvlisting}",
            "",
            "\\newfontfamily{\\cascadia}{Cascadia Code}",
            "\\newjfontfamily{\\jcodefont}{Harano Aji Gothic Regular}",
            "\\newfontfamily{\\consolas}{Consolas}",
            "",
            "\\renewcommand{\\lstlistingname}{ソースコード}",
            "\\definecolor{CommentColor}{rgb}{0.0,0.3,0.1}",
            "\\definecolor{StringColor}{rgb}{0.7,0.3,0.1}",
            "\\definecolor{IdentifierColor}{rgb}{0.0, 0.3, 0.7}",
            "\\definecolor{KeywordColor}{rgb}{0.5,0.1,0.5}",
            "\\definecolor{NumColor}{rgb}{0.30, 0.30, 0.30}",
            "\\definecolor{BGColor}{rgb}{0.95,0.95,0.95}",
            "",
            "\\lstdefinestyle{baseStyle}{",
            "    basicstyle={\\small\\cascadia\\jcodefont},",
            "    frame={single},",
            "    breaklines=true,",
            "    columns=fixed,",
            "    basewidth=0.5em,",
            "    numbers=left,",
            "    xrightmargin=0\\zw,",
            "    xleftmargin=3\\zw,",
            "    stepnumber=1,",
            "    numbersep=1\\zw,",
            "    lineskip=-0.4ex,",
            "    commentstyle={\\color{CommentColor}},",
            "    keywordstyle={\\color{KeywordColor}},",
            "    numberstyle={\\consolas\\color{NumColor}},",
            "    ndkeywordstyle={\\color{blue}},",
            "    identifierstyle={\\color{IdentifierColor}},",
            "    stringstyle={\\small\\color{StringColor}},",
            "    backgroundcolor=\\color{BGColor},",
            "    tabsize=2",
            "}",
            "",
            "\\lstdefinelanguage{JavaScript}{",
            "    keywords={typeof, new, true, false, catch, function, return, null, catch, switch, var, if, in, while, do, else, case, break, let, const, class, export, import, extends},",
            "    keywordstyle=\\color{KeywordColor},",
            "    ndkeywords={class, export, boolean, throw, implements, import, this},",
            "    ndkeywordstyle=\\color{blue},",
            "    identifierstyle=\\color{IdentifierColor},",
            "    sensitive=false,",
            "    comment=[l]{//},",
            "    morecomment=[s]{/*}{*/},",
            "    morestring=[b]',",
            "    morestring=[b]\"",
            "}",
            "",
            "\\lstdefinestyle{styleJava}{style=baseStyle, language=Java}",
            "\\lstdefinestyle{styleJS}{style=baseStyle, language=JavaScript}",
            "\\lstdefinestyle{stylePython}{style=baseStyle, language=Python}",
            "\\lstdefinestyle{styleC}{style=baseStyle, language=C}",
            "\\lstdefinestyle{styleNone}{",
            "    style=baseStyle,",
            "    identifierstyle=\\color{black},",
            "    keywordstyle=\\color{black},",
            "    ndkeywordstyle=\\color{black},",
            "    stringstyle=\\color{black},",
            "    commentstyle=\\color{black},",
            "    numberstyle=\\color{black}",
            "}",
            "% --- ここまでソースコード表示用設定 ---"
        ],
        "description": "プログラムを貼り付けるテンプレ"
    },
}